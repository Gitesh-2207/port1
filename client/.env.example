# EmailJS Credentials
# Sign up / Log in at https://www.emailjs.com/
# 1. Email Services -> Service ID (e.g., service_xxxxxxx)
VITE_EMAILJS_SERVICE_ID=your_service_id

# 2. Email Templates -> Template ID (e.g., template_xxxxxxx)
VITE_EMAILJS_TEMPLATE_ID=your_template_id

# 3. Account -> API Keys -> Public Key (e.g., xxxxxxxxxxxxxxxx)
VITE_EMAILJS_PUBLIC_KEY=your_public_key
